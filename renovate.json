{
  "extends": ["docker:pinDigests"],
  "prHourlyLimit": 0,
  "ignorePaths": ["charts/**"],
  "enabledManagers": ["flux", "helm-values", "kubernetes"],
  "flux": { "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"] },
  "helm-values": { "managerFilePatterns": ["/^apps/production/.+\\.ya?ml$/"] },
  "kubernetes": { "managerFilePatterns": ["/^(apps|infrastructure)/.+\\.ya?ml$/"] },
  "packageRules": [
    {
      "description": "Keel follows latest.",
      "matchCurrentValue": "latest",
      "enabled": false
    },
    {
      "description": "Production pins latest to a digest that moves on Mondays.",
      "matchFileNames": ["apps/production/**"],
      "matchCurrentValue": "latest",
      "enabled": true
    },
    {
      "description": "Container images only, not Helm charts.",
      "matchDatasources": ["helm"],
      "enabled": false
    },
    {
      "description": "Chart sources, not container images.",
      "matchFileNames": ["infrastructure/helm/**"],
      "enabled": false
    },
    {
      "description": "The wikibase chart reuses this tag for apache-assets, so a digest would not match both images.",
      "matchPackageNames": ["ghcr.io/mardi4nfdi/wikibase"],
      "pinDigests": false
    },
    {
      "description": "One weekly pull request for everything but major updates.",
      "matchUpdateTypes": ["pin", "pinDigest", "digest", "patch", "minor"],
      "groupName": "container images"
    },
    {
      "description": "The QLever database image must match the index, so it gets its own pull request.",
      "matchPackageNames": ["adfreiburg/qlever"],
      "groupName": "qlever database"
    }
  ]
}
